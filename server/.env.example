# Recap Studio v2 — local server
# Copy this file to .env  (or just type the keys into the app's Settings modal)

PORT=5002

# No accounts / no sign-in — anyone who can reach this server can use it and
# view/edit the shared keys below via Settings. Only put this URL somewhere
# you're OK with being open.

# Transcription — https://www.assemblyai.com  (auto language detection)
ASSEMBLYAIKEY=
ASSEMBLYAI_API_KEY=

# Translation — Gemini. AIza… = Google direct, anything else = OpenRouter
GEMINIKEY=
GEMINI_API_KEY=

# Optional fallback transcription when AssemblyAI fails
GROQ_API_KEY=

# Optional: use your own ffmpeg instead of the bundled static build
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
